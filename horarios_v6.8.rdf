    <!-- http://iscte.pt/ontologias/horarios#AulaSemSalaAtribuida -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#AulaSemSalaAtribuida">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Aula que necessita de sala mas não tem nenhuma atribuída (ausência da relação utilizaSala e caracPedida diferente de "Não necessita de sala").</rdfs:comment>
        <rdfs:label xml:lang="pt">Aula_Sem_Sala_Atribuida</rdfs:label>
    </owl:Class>

    <!-- http://iscte.pt/ontologias/horarios#AulaSobrelotada -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#AulaSobrelotada">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Aula em que o número de inscritos no turno excede a capacidade normal da sala (excedente &gt; 0).</rdfs:comment>
        <rdfs:label xml:lang="pt">Aula_Sobrelotada</rdfs:label>
    </owl:Class>

    <!-- http://iscte.pt/ontologias/horarios#AulaComSalaInadequada -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#AulaComSalaInadequada">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Aula em que a sala atribuída não possui a característica pedida (adequacao = "inadequada").</rdfs:comment>
        <rdfs:label xml:lang="pt">Aula_Com_Sala_Inadequada</rdfs:label>
    </owl:Class>

    <!-- http://iscte.pt/ontologias/horarios#AulaComSobreposicaoTurno -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#AulaComSobreposicaoTurno">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Aula que se sobrepõe temporalmente com outra aula do mesmo turno no mesmo dia.</rdfs:comment>
        <rdfs:label xml:lang="pt">Aula_Com_Sobreposicao_Turno</rdfs:label>
    </owl:Class>

    <!-- http://iscte.pt/ontologias/horarios#AulaComSobreposicaoSala -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#AulaComSobreposicaoSala">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Aula que se sobrepõe temporalmente com outra aula de turno diferente na mesma sala no mesmo dia.</rdfs:comment>
        <rdfs:label xml:lang="pt">Aula_Com_Sobreposicao_Sala</rdfs:label>
    </owl:Class>


