    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // EXTENSÃO v5.0 — Camada de escalonamento (parallel machine scheduling)
    // Aula = pedido/encomenda | Sala = máquina | TipoSala = grupo de máquinas
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- ======================= Classes ======================= -->

    <!-- http://iscte.pt/ontologias/horarios#Semana -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Semana">
        <rdfs:label xml:lang="pt">Semana</rdfs:label>
        <rdfs:comment xml:lang="pt">Horizonte de planeamento semanal. O horário é gerado semana a semana; a instância do problema é o conjunto de aulas (pedidos) de uma semana e o conjunto de salas (máquinas) disponíveis. v6.5: a dimensão real da instância no dataset ISCTE 2022/23 é de 1.664 a 2.198 pedidos T/TP/PL por semana, e não os ~500 estimados na reunião. A propriedade semanaCompleta distingue as semanas sem feriados, únicas admissíveis como instância de trabalho.</rdfs:comment>
    </owl:Class>

        <!-- http://iscte.pt/ontologias/horarios#HorarioGerado -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#HorarioGerado">
        <rdfs:label xml:lang="pt">Horário Gerado</rdfs:label>
        <rdfs:comment xml:lang="pt">Uma solução alternativa produzida pelo algoritmo de escalonamento para uma Semana. O algoritmo gera múltiplos horários alternativos; o decisor compara-os no espaço de qualidade (desperdício total) e no espaço de decisão (alocações concretas).</rdfs:comment>
    </owl:Class>

    <!-- http://iscte.pt/ontologias/horarios#Alocacao -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Alocacao">
        <rdfs:label xml:lang="pt">Alocação</rdfs:label>
        <rdfs:comment xml:lang="pt">Elemento atómico de um HorarioGerado: a decisão de processar um pedido (Aula) numa máquina (Sala) numa posição da linha temporal (dia útil, 08:00–19:30). As variáveis de decisão do problema são a ordem das aulas e a sala atribuída; a Alocacao materializa o valor dessas variáveis numa solução.</rdfs:comment>
    </owl:Class>

    <!-- ======================= Object Properties ======================= -->

    <!-- http://iscte.pt/ontologias/horarios#pertenceASemana -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#pertenceASemana">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Semana"/>
        <rdfs:label xml:lang="pt">pertence à semana</rdfs:label>
    </owl:ObjectProperty>

            <!-- http://iscte.pt/ontologias/horarios#elegivelPara -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#elegivelPara">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Sala"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:label xml:lang="pt">elegível para</rdfs:label>
        <rdfs:comment xml:lang="pt">Aresta de elegibilidade materializada (conjunto M_i). Decorre de duas condições cumulativas: o tipo de sala exigido pelo pedido é satisfeito por algum tipo da sala (HC2, através da relação satisfeitaPor) e a capacidade da sala comporta os inscritos, opcionalmente com a tolerância alfa. v6.7: a segunda condição NÃO é uma restrição numerada — é parte da definição de M_i, com a mesma forma que a primeira. Também não é dispensável: a função objetivo soma termos (c−e) e, sem a garantia c >= e, o termo pode ser negativo, pelo que minimizar o desperdício passaria a premiar a sobrelotação. Pré-computada para alimentar diretamente o algoritmo.</rdfs:comment>
    </owl:ObjectProperty>

    <!-- http://iscte.pt/ontologias/horarios#horarioDaSemana -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#horarioDaSemana">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#HorarioGerado"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Semana"/>
        <rdfs:label xml:lang="pt">horário da semana</rdfs:label>
    </owl:ObjectProperty>

    <!-- http://iscte.pt/ontologias/horarios#contemAlocacao -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#contemAlocacao">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#HorarioGerado"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Alocacao"/>
        <rdfs:label xml:lang="pt">contém alocação</rdfs:label>
    </owl:ObjectProperty>

    <!-- http://iscte.pt/ontologias/horarios#alocaAula -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#alocaAula">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Alocacao"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:label xml:lang="pt">aloca aula</rdfs:label>
    </owl:ObjectProperty>

    <!-- http://iscte.pt/ontologias/horarios#alocaSala -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#alocaSala">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Alocacao"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Sala"/>
        <rdfs:label xml:lang="pt">aloca sala</rdfs:label>
    </owl:ObjectProperty>

    <!-- ======================= Datatype Properties ======================= -->

    <!-- http://iscte.pt/ontologias/horarios#tipoSala -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#tipoSala">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Sala"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">tipo de sala</rdfs:label>
        <rdfs:comment xml:lang="pt">Atributo da sala conforme a formulação do problema (tipo de sala + capacidade). Uma sala pode acumular vários tipos (ex.: um laboratório também pode acolher aulas normais); derivado das características reais que pertencem ao vocabulário dos tipos pedidos. Os grupos de máquinas do mesmo tipo obtêm-se por agregação sobre este atributo.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#duracaoMin -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#duracaoMin">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pt">duração em minutos</rdfs:label>
        <rdfs:comment xml:lang="pt">Duração do pedido: a aula ocupa um bloco temporal contíguo desta duração (sem preempção).</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#anoSemana -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#anoSemana">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Semana"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pt">ano da semana</rdfs:label>
        <rdfs:comment xml:lang="pt">Componente numérica do ano em semanaId — é o "weekYear" ISO 8601 (o ano a que a semana pertence segundo a norma), não necessariamente o ano civil de todos os dias da semana: nos limites dezembro/janeiro os dois podem divergir (ex.: 1 jan 2023, domingo, tem weekYear 2022). Guardado separado de numeroSemana para permitir comparação/ordenação numérica sem ter de particionar a string semanaId.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#numeroSemana -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#numeroSemana">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Semana"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pt">número ISO da semana</rdfs:label>
        <rdfs:comment xml:lang="pt">Número da semana ISO 8601 DENTRO DO ANO CIVIL (0–53) — não é o número da semana letiva do semestre. Para "semana 2, 3, 4 do semestre" usar numeroSemanaLetiva.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#numeroSemanaLetiva -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#numeroSemanaLetiva">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Semana"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pt">número da semana letiva</rdfs:label>
        <rdfs:comment xml:lang="pt">Posição da semana dentro do semestre (1, 2, 3, ...), contada cronologicamente a partir da primeira semana com aulas desse semestre. Distinto de numeroSemana (que é o número ISO no ano civil).</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#semanaId -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#semanaId">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Semana"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">identificador da semana</rdfs:label>
        <rdfs:comment xml:lang="pt">Chave única da semana, no formato "ANO-Wnn" (ex.: "2022-W48"), concatenando anoSemana e numeroSemana com zero à esquerda no número. Existe para servir de identificador legível e de chave da CONSTRAINT semana_id — evita ter de combinar anoSemana+numeroSemana em cada MERGE/parâmetro. Usada como valor do parâmetro $semanaAlvo (fase 8.4) que escolhe a semana de trabalho para o algoritmo de escalonamento.</rdfs:comment>
    </owl:DatatypeProperty>

        <!-- http://iscte.pt/ontologias/horarios#horarioId -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#horarioId">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#HorarioGerado"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">identificador do horário gerado</rdfs:label>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#dataGeracao -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#dataGeracao">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#HorarioGerado"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="pt">data de geração</rdfs:label>
        <rdfs:comment xml:lang="pt">Momento em que a solução foi escrita no grafo (fase 11.2). v15: propriedade já escrita pelo Cypher desde a v14 mas em falta na ontologia — adicionada por completude.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#algoritmo -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#algoritmo">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#HorarioGerado"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">algoritmo</rdfs:label>
        <rdfs:comment xml:lang="pt">Identificação do algoritmo/configuração que produziu a solução (ex.: 'IG-RVND', 'CP-SAT').</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#desperdicioTotal -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#desperdicioTotal">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#HorarioGerado"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pt">desperdício total</rdfs:label>
        <rdfs:comment xml:lang="pt">Valor da função objetivo única do problema: soma, sobre todas as alocações, de (capacidade normal da sala − inscritos no turno). A minimizar.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#ordem -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#ordem">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Alocacao"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pt">ordem</rdfs:label>
        <rdfs:comment xml:lang="pt">Posição do pedido na ordem de despacho σ escolhida pelo algoritmo (variável de decisão), compatível com a ordem parcial T ≺ TP ≺ PL. É a partir de σ, e da sala atribuída, que se deriva o instanteInicio: os pedidos são colocados por ordem crescente de σ, cada um no instante mais cedo em que a sua sala está livre e as precedências estão satisfeitas.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#desperdicio -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#desperdicio">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Alocacao"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pt">desperdício</rdfs:label>
        <rdfs:comment xml:lang="pt">Contribuição da alocação para a função objetivo: capacidade da sala − inscritos.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#diaAlocado -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#diaAlocado">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Alocacao"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">dia alocado</rdfs:label>
        <rdfs:comment xml:lang="pt">Dia útil em que a alocação ocorre (Seg a Sex). v6.8: componente da posição theta na grelha temporal H = D x K, a par de horaInicioAlocada. Não é variável de decisão — deriva do par (sigma, x) por despacho pela ordem sigma.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#horaInicioAlocada -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#horaInicioAlocada">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Alocacao"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pt">hora de início alocada (minutos)</rdfs:label>
        <rdfs:comment xml:lang="pt">Instante de início da alocação dentro do dia, em minutos desde a meia-noite, restrito aos nove blocos da grelha institucional (480, 570, 660, 780, 870, 960, 1080, 1170, 1260 — ou seja 08:00 a 21:00). v6.8: componente da posição theta, a par de diaAlocado. O limite superior efetivo é o parâmetro do pipeline ultimoInicio: 1170 (19:30) no caso base, que é a simplificação proposta na orientação, ou 1260 (21:00) na variante que reproduz a grelha real e recupera o periodo pos-laboral. O fim da ocupação e horaInicioAlocada + duracaoMin e nunca ultrapassa 1350 (22:30).</rdfs:comment>
    </owl:DatatypeProperty>


    <!-- ================================================================== -->
    <!-- EXTENSÃO v6.5 — Identidade do pedido, baseline observado,          -->
    <!-- elegibilidade e descritores de solução                             -->
    <!-- ================================================================== -->

    <!-- ===== Object Properties ===== -->

    <!-- http://iscte.pt/ontologias/horarios#satisfeitaPor -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#satisfeitaPor">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#CaracteristicaPedida"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#CaracteristicaReal"/>
        <rdfs:label xml:lang="pt">satisfeita por</rdfs:label>
        <rdfs:comment xml:lang="pt">Tabela de correspondência entre o vocabulário de características PEDIDAS (coluna Fénix da aula) e o vocabulário de características REAIS das salas. Existe porque os dois vocabulários não coincidem: 'Sala/anfiteatro aulas' é satisfeita por 'Anfiteatro aulas' OU por 'Sala de Aulas normal', e nenhuma delas tem o mesmo nome. A v6.4 resolvia a elegibilidade por igualdade nominal estrita, o que deixava sem qualquer máquina 16% dos pedidos da semana — 191 deles apenas por esta não-correspondência, apesar de o pipeline já saber mapeá-la no cálculo da adequação. Materializar a correspondência numa relação única elimina a duplicação de regras e torna a elegibilidade auditável.</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ===== Datatype Properties ===== -->

    <!-- http://iscte.pt/ontologias/horarios#pedidoId -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#pedidoId">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">identificador do pedido</rdfs:label>
        <rdfs:comment xml:lang="pt">Identificador do pedido (encomenda) na formulação de escalonamento, no formato 'semanaId|codigoTurno#ocorrencia' (ex.: '2022-W41|01789TP01#2'). Distinto de aulaId, que é a chave técnica da linha do CSV e inclui sala, dia e hora — ou seja, as próprias variáveis de decisão, pelo que não pode identificar a encomenda sem circularidade. O índice de ocorrência é necessário porque, nos dados reais, 45% dos turnos têm 2 a 6 sessões na mesma semana: o pressuposto de que o triplo (disciplina, tipo, turno) é único por semana não se verifica.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#ocorrenciaNaSemana -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#ocorrenciaNaSemana">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pt">ocorrência na semana</rdfs:label>
        <rdfs:comment xml:lang="pt">Índice da sessão dentro do turno, na semana. Atribuído por ordem cronológica observada apenas para ser determinístico; não impõe qualquer ordem à solução, que é decidida pela variável σ.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#alocavel -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#alocavel">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="pt">alocável</rdfs:label>
        <rdfs:comment xml:lang="pt">Verdadeiro se o pedido tem pelo menos uma máquina elegível (característica satisfeita E capacidade suficiente). Pedidos não alocáveis saem de P e são reportados ao decisor como infeasibilidade estrutural, em vez de falharem silenciosamente no algoritmo.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#motivoNaoAlocavel -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#motivoNaoAlocavel">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">motivo de não alocabilidade</rdfs:label>
        <rdfs:comment xml:lang="pt">Diagnóstico da infeasibilidade: 'nao_requer_sala' (o pedido não precisa de máquina, ex.: 'Não necessita de sala'), 'caracteristica_sem_sala_no_parque' (a característica pedida não existe em nenhuma sala, ex.: 'Lab ISTA'), 'sem_sala_com_capacidade_suficiente' (existem salas do tipo certo mas todas pequenas demais — candidato ao mecanismo de tolerância), 'sem_caracteristica_pedida'.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#inscritos -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#inscritos">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pt">inscritos no pedido</rdfs:label>
        <rdfs:comment xml:lang="pt">Número de estudantes do pedido (e_i na formulação). v6.5: substitui a escrita de inscritosNoTurno no nó Aula, cujo rdfs:domain é Turno — em OWL, escrevê-la numa Aula implicaria por inferência que a Aula é um Turno.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#capacidadeObservada -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#capacidadeObservada">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pt">capacidade da sala observada</rdfs:label>
        <rdfs:comment xml:lang="pt">Capacidade da sala efetivamente utilizada no horário REAL (baseline). Desnormalização de conveniência; não faz parte da instância do problema. Substitui a escrita de capacidadeNormal (domínio Sala) no nó Aula.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#salaObservada -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#salaObservada">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">sala observada</rdfs:label>
        <rdfs:comment xml:lang="pt">Nome da sala efetivamente utilizada no horário REAL (baseline). Não é a resposta do algoritmo — essa vive na relação alocaSala da Alocacao. Substitui a escrita de nomeSala (domínio Sala) no nó Aula.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#caracRealObservada -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#caracRealObservada">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">características reais da sala observada</rdfs:label>
        <rdfs:comment xml:lang="pt">Lista das características reais da sala utilizada no horário REAL (baseline). v6.5: a v6.4 escrevia esta propriedade sob o nome caracReal sem sequer a declarar na ontologia — era a única propriedade do pipeline sem contrapartida ontológica.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#rotuloUnidade -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#rotuloUnidade">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">rótulo da unidade de execução</rdfs:label>
        <rdfs:comment xml:lang="pt">Nome da unidade de execução, replicado no nó Aula para acesso direto. É um label: conforme a formulação, o nome da disciplina não entra no problema. Substitui a escrita de nomeUnidade (domínio UnidadeExecucao) no nó Aula.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#rotuloVisual -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#rotuloVisual">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#UnidadeExecucao"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">rótulo de visualização</rdfs:label>
        <rdfs:comment xml:lang="pt">Nome da unidade de execução concatenado com o(s) curso(s) a que pertence. IMPORTANTE — esta propriedade não acrescenta informação: o curso é obtido pela relação pertenceACurso, e é essa a fonte de verdade. É uma desnormalização de apresentação, com duas justificações concretas e nenhuma outra. Primeira: o Neo4j Browser e o Bloom mostram uma única propriedade como legenda de cada nó, pelo que sem um campo pré-concatenado o nome do curso simplesmente não aparece no ecrã ao navegar o grafo. Segunda: evita repetir o traversal e a agregação por curso em cada consulta de visualização, que são executadas por alocação e não por disciplina. O próprio orientador a classificou assim: "isso vai ser só para efeitos da visualização, senão para o problema é indiferente". Se a duplicação incomodar, pode ser removida sem qualquer perda de informação — apenas se paga o traversal em cada consulta.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#requerSala -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#requerSala">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#CaracteristicaPedida"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="pt">requer sala</rdfs:label>
        <rdfs:comment xml:lang="pt">Falso para as características pedidas que dispensam máquina (ex.: 'Não necessita de sala'). Os pedidos correspondentes saem do conjunto P sem serem contados como infeasíveis.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#diasUteisComAulas -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#diasUteisComAulas">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Semana"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pt">dias úteis com aulas</rdfs:label>
        <rdfs:comment xml:lang="pt">Número de dias úteis (Seg–Sex) da semana em que existe pelo menos uma aula. Menor que 5 indica feriado.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#semanaCompleta -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#semanaCompleta">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Semana"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="pt">semana completa</rdfs:label>
        <rdfs:comment xml:lang="pt">Verdadeiro se os cinco dias úteis têm aulas. v6.5: critério de seleção da instância de trabalho. O orientador pediu 'os dados de uma semana que esteja a funcionar'; no ano letivo 2022/23 as semanas W40, W44, W48 e W49 contêm feriados e não satisfazem esse requisito.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#desperdicioReferencia -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#desperdicioReferencia">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Semana"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pt">desperdício de referência</rdfs:label>
        <rdfs:comment xml:lang="pt">Melhor valor conhecido da função objetivo para a semana — o ótimo certificado, quando o método exato o prova. Serve de âncora para o gap relativo das soluções alternativas apresentadas ao decisor.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#gapRelativo -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#gapRelativo">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#HorarioGerado"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">gap relativo</rdfs:label>
        <rdfs:comment xml:lang="pt">Distância relativa do desperdício total desta solução face ao desperdicioReferencia da semana. Permite afirmar ao decisor que um conjunto de alternativas é equivalente em qualidade (ex.: todas a menos de 2% do ótimo) e que a escolha entre elas é, portanto, uma decisão sobre o espaço de decisão e não sobre a qualidade.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#numAlocacoes -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#numAlocacoes">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#HorarioGerado"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pt">número de alocações</rdfs:label>
        <rdfs:comment xml:lang="pt">Número de pedidos alocados na solução. Deve igualar o número de pedidos alocáveis da semana.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#salasUsadas -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#salasUsadas">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#HorarioGerado"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pt">salas usadas</rdfs:label>
        <rdfs:comment xml:lang="pt">Número de salas distintas mobilizadas pela solução. Descritor do espaço de decisão: duas soluções com o mesmo desperdício podem concentrar ou dispersar a ocupação do campus.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#piorAlocacao -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#piorAlocacao">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#HorarioGerado"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pt">pior alocação</rdfs:label>
        <rdfs:comment xml:lang="pt">Maior desperdício individual de uma alocação. Um total baixo pode esconder uma alocação muito má; este descritor expõe-a.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#alocacoesMuitoFolgadas -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#alocacoesMuitoFolgadas">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#HorarioGerado"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pt">alocações muito folgadas</rdfs:label>
        <rdfs:comment xml:lang="pt">Número de alocações com desperdício acima de um limiar (por omissão 30 lugares). Descritor de equidade da solução.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#slotId -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#slotId">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#SlotTemporal"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">identificador do slot</rdfs:label>
        <rdfs:comment xml:lang="pt">Chave composta do bloco temporal observado, no formato "DIADASEMANA_HHMMi_HHMMf" (ex.: "Sexta-Feira_1400_1530"). v6.5: declarada — era escrita pelo pipeline sem contrapartida na ontologia.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#duracao -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#duracao">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#SlotTemporal"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pt">duração do slot (minutos)</rdfs:label>
        <rdfs:comment xml:lang="pt">Duração do bloco temporal observado, em minutos. Não confundir com duracaoMin, que é a duração do PEDIDO na formulação. v6.5: declarada — era escrita pelo pipeline sem contrapartida na ontologia.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#rotuloPedido -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#rotuloPedido">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">rótulo do pedido</rdfs:label>
        <rdfs:comment xml:lang="pt">Rótulo legível do pedido: rotuloVisual da unidade de execução (disciplina + curso) concatenado com o tipo de aula. Como rotuloVisual, é desnormalização de apresentação e não fonte de informação. Não confundir com pedidoId, que é o identificador único e funcional do pedido: o rótulo é descartável, o identificador não. Declarado com domínio Aula, e não reutilizando rotuloVisual (domínio UnidadeExecucao), para não incorrer na violação de domínio corrigida na v6.5.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#inicioMin -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#inicioMin">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#SlotTemporal"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pt">início do slot (minutos)</rdfs:label>
        <rdfs:comment xml:lang="pt">Hora de início do bloco temporal observado, em minutos desde as 00:00. v6.5: declarada com domínio SlotTemporal; a v6.4 escrevia horaInicioMin (domínio Aula) nestes nós.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#fimMin -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#fimMin">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#SlotTemporal"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pt">fim do slot (minutos)</rdfs:label>
        <rdfs:comment xml:lang="pt">Hora de fim do bloco temporal observado, em minutos desde as 00:00. v6.5: declarada com domínio SlotTemporal; a v6.4 escrevia horaFimMin (domínio Aula) nestes nós.</rdfs:comment>
    </owl:DatatypeProperty>


    <!-- ================================================================== -->
    <!-- EXTENSÃO v6.6 — Localização temporal da semana e navegação          -->
    <!-- entre soluções alternativas                                        -->
    <!-- ================================================================== -->

    <!-- ===== Object Properties ===== -->

    <!-- http://iscte.pt/ontologias/horarios#semanaSeguinte -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#semanaSeguinte">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Semana"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Semana"/>
        <rdfs:label xml:lang="pt">semana seguinte</rdfs:label>
        <rdfs:comment xml:lang="pt">Encadeamento cronológico das semanas do semestre, por dataInicio. Torna a ordem entre semanas um facto do grafo em vez de uma reconstrução por ordenação em cada consulta, e permite comparar semanas consecutivas por travessia.</rdfs:comment>
    </owl:ObjectProperty>

    <!-- http://iscte.pt/ontologias/horarios#horarioReferencia -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#horarioReferencia">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Semana"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#HorarioGerado"/>
        <rdfs:label xml:lang="pt">horário de referência</rdfs:label>
        <rdfs:comment xml:lang="pt">Liga a semana ao horário de menor desperdício conhecido — tipicamente o ótimo certificado pelo método exato. A propriedade desperdicioReferencia guardava o VALOR; esta relação guarda a IDENTIDADE da solução que o atinge, que é o que o decisor precisa para comparar qualquer alternativa contra a melhor.</rdfs:comment>
    </owl:ObjectProperty>

    <!-- http://iscte.pt/ontologias/horarios#comparadoCom -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#comparadoCom">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#HorarioGerado"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#HorarioGerado"/>
        <rdfs:label xml:lang="pt">comparado com</rdfs:label>
        <rdfs:comment xml:lang="pt">Comparação par a par entre dois horários alternativos da mesma semana, materializada como aresta. Transporta, como propriedades da relação no grafo de propriedades (pedidosComuns, pedidosDiferentes, mudamSala, mudamHorario, distancia, difDesperdicio), a distância de Hamming no espaço de decisão: quantos pedidos mudam de sala, de posição temporal, ou de ambas. Nota de modelação: estas propriedades vivem na relação Neo4j e não são declaráveis em OWL, onde uma ObjectProperty não admite atributos — a mesma situação já existente em emConflitoSala e emConflitoTurno. Razão de existir: o espaço de decisão é o objeto que o decisor navega, e navegar pressupõe arestas; sem esta relação, escolher o subconjunto representativo de alternativas a apresentar exigiria recalcular todas as distâncias por agregação em cada consulta.</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ===== Datatype Properties ===== -->

    <!-- http://iscte.pt/ontologias/horarios#dataInicio -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#dataInicio">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Semana"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="pt">data de início da semana</rdfs:label>
        <rdfs:comment xml:lang="pt">Segunda-feira da semana ISO, obtida por truncagem da data de qualquer aula da semana. Responde à pergunta que o semanaId não responde: '2022-W43' diz a posição no ano, dataInicio diz que a semana começa a 24 de outubro.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#dataFim -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#dataFim">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Semana"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="pt">data de fim da semana</rdfs:label>
        <rdfs:comment xml:lang="pt">Domingo da semana ISO (dataInicio + 6 dias). Delimita o intervalo temporal completo da semana, incluindo o fim de semana, que fica fora do horizonte de alocação mas dentro do intervalo de calendário.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#rotuloSemana -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#rotuloSemana">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Semana"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">rótulo da semana</rdfs:label>
        <rdfs:comment xml:lang="pt">Forma legível do intervalo, no formato 'DD/MM a DD/MM/AAAA' (ex.: '24/10 a 30/10/2022'). Existe pela mesma razão que qualquer rótulo: o Neo4j Browser mostra uma única propriedade como legenda de um nó, e '2022-W43' não situa ninguém no calendário.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#salaValida -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#salaValida">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Sala"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="pt">sala válida como máquina</rdfs:label>
        <rdfs:comment xml:lang="pt">Falso para salas sem capacidade declarada, que não podem servir de máquina: sem capacidade não é possível verificar se os alunos cabem nem calcular o desperdício. Torna a exclusão explícita e auditável, em vez de resultar de um teste de nulidade escondido numa cláusula WHERE.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#instanteInicio -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#instanteInicio">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Alocacao"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pt">instante de início</rdfs:label>
        <rdfs:comment xml:lang="pt">Posição da alocação na semana, em minutos desde segunda-feira às 08:00. É a mesma informação que o par (diaAlocado, horaInicioAlocada), guardada de forma escalar por tornar trivial a aritmética de sobreposição: dois pedidos na mesma sala colidem se e só se os intervalos [instanteInicio, instanteInicio + duracaoMin) se intersetarem, sem necessidade de comparar dias. Recupera-se o dia com instanteInicio / 1440 e a hora com instanteInicio % 1440 + 480. Não é variável de decisão: deriva do par (sigma, x).</rdfs:comment>
    </owl:DatatypeProperty>

</rdf:RDF>
