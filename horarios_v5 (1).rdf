    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // NOVO v5.0: Classe RecursoHumano e subclasse Professor
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- http://iscte.pt/ontologias/horarios#RecursoHumano -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#RecursoHumano">
        <rdfs:comment xml:lang="pt">Classe abstrata para recursos humanos envolvidos no horário (Professores, Funcionários, etc.).</rdfs:comment>
        <rdfs:label xml:lang="pt">RecursoHumano</rdfs:label>
    </owl:Class>

    <!-- http://iscte.pt/ontologias/horarios#Professor -->
    <!-- NOVO v5: Docente que leciona um ou mais Turnos. -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Professor">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#RecursoHumano"/>
        <rdfs:comment xml:lang="pt">Docente responsável por um ou mais turnos. Um professor não pode estar presente em dois turnos com sobreposição temporal no mesmo dia.</rdfs:comment>
        <rdfs:label xml:lang="pt">Professor</rdfs:label>
    </owl:Class>


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // NOVO v5.0: Object Properties para Professor
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- http://iscte.pt/ontologias/horarios#TurnoTemProfessor -->
    <!-- NOVO v5: Liga um Turno ao seu Professor. -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#TurnoTemProfessor">
        <owl:inverseOf rdf:resource="http://iscte.pt/ontologias/horarios#ProfessorLecionaTurno"/>
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Turno"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Professor"/>
        <rdfs:label xml:lang="pt">turnoTemProfessor</rdfs:label>
        <rdfs:comment xml:lang="pt">Liga um turno ao docente que o leciona. Fonte: professores.csv (a criar).</rdfs:comment>
    </owl:ObjectProperty>

    <!-- http://iscte.pt/ontologias/horarios#ProfessorLecionaTurno -->
    <!-- NOVO v5: Inverso de TurnoTemProfessor. -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#ProfessorLecionaTurno">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Professor"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Turno"/>
        <rdfs:label xml:lang="pt">professorLecionaTurno</rdfs:label>
        <rdfs:comment xml:lang="pt">Inverso de TurnoTemProfessor: aponta de um Professor para os Turnos que leciona.</rdfs:comment>
    </owl:ObjectProperty>

    <!-- http://iscte.pt/ontologias/horarios#emConflitoProfessor -->
    <!-- NOVO v5: conflito temporal entre aulas com o mesmo professor no mesmo dia. -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#emConflitoProfessor">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Liga duas aulas leccionadas pelo mesmo professor que se sobrepõem temporalmente no mesmo dia. Requer dados de professores.csv.</rdfs:comment>
        <rdfs:label xml:lang="pt">emConflitoProfessor</rdfs:label>
    </owl:ObjectProperty>


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // NOVO v5.0: Data Properties para Professor
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- http://iscte.pt/ontologias/horarios#nomeProfessor -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#nomeProfessor">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Professor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">nomeProfessor</rdfs:label>
        <rdfs:comment xml:lang="pt">Nome completo do docente.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#emailProfessor -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#emailProfessor">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Professor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">emailProfessor</rdfs:label>
        <rdfs:comment xml:lang="pt">Email institucional do docente (ex: nome@iscte-iul.pt).</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#departamento -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#departamento">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Professor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">departamento</rdfs:label>
        <rdfs:comment xml:lang="pt">Departamento ou unidade orgânica do docente (ex: DCTI, ISTA).</rdfs:comment>
    </owl:DatatypeProperty>


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // NOVO v5.0: Subclasse de anomalia para sobreposição de professor
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- http://iscte.pt/ontologias/horarios#AulaComSobreposicaoProfessor -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#AulaComSobreposicaoProfessor">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Aula em que o professor responsável tem outra aula no mesmo dia com sobreposição temporal (o professor estaria em dois sítios ao mesmo tempo).</rdfs:comment>
        <rdfs:label xml:lang="pt">Aula_Com_Sobreposicao_Professor</rdfs:label>
    </owl:Class>


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // NOVO v5.0: Data Properties de suporte à otimização (resultado dos algoritmos)
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- http://iscte.pt/ontologias/horarios#slotOtimizado -->
    <!-- NOVO v5: slot temporal proposto pelo algoritmo (DSATUR/NSGA-II) para este turno. -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#slotOtimizado">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Turno"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">SlotId proposto pelo algoritmo de otimização para este turno (formato: DiaDaSemana_HHMMi_HHMMf). Null enquanto o algoritmo não foi executado.</rdfs:comment>
        <rdfs:label xml:lang="pt">slotOtimizado</rdfs:label>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#salaOtimizada -->
    <!-- NOVO v5: sala proposta pelo algoritmo para este turno. -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#salaOtimizada">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Turno"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">NomeSala proposto pelo algoritmo de otimização para este turno. Null enquanto o algoritmo não foi executado.</rdfs:comment>
        <rdfs:label xml:lang="pt">salaOtimizada</rdfs:label>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#objetivoSobrelotacao -->
    <!-- NOVO v5: valor da função objetivo f1 (sobrelotação) para este turno na solução proposta. -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#objetivoSobrelotacao">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Turno"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="pt">Valor da função objetivo f1 (nº alunos acima da capacidade normal na sala proposta) para este turno na solução otimizada.</rdfs:comment>
        <rdfs:label xml:lang="pt">objetivoSobrelotacao</rdfs:label>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#objetivoAdequacao -->
    <!-- NOVO v5: valor da função objetivo f2 (inadequação de sala) para este turno. -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#objetivoAdequacao">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Turno"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="pt">Valor da função objetivo f2 (0 se sala adequada, 1 se inadequada) para este turno na solução otimizada.</rdfs:comment>
        <rdfs:label xml:lang="pt">objetivoAdequacao</rdfs:label>
    </owl:DatatypeProperty>

    <!-- http://iscte.pt/ontologias/horarios#objetivoFolgas -->
    <!-- NOVO v5: valor da função objetivo f3 (folgas excessivas) para este turno. -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#objetivoFolgas">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Turno"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="pt">Valor da função objetivo f3 (minutos de folga entre aulas consecutivas acima do limiar) para este turno na solução otimizada.</rdfs:comment>
        <rdfs:label xml:lang="pt">objetivoFolgas</rdfs:label>
    </owl:DatatypeProperty>

</rdf:RDF>
