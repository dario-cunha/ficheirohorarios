<?xml version="1.0"?>
<rdf:RDF xmlns="http://iscte.pt/ontologias/horarios#"
     xml:base="http://iscte.pt/ontologias/horarios"
     xmlns:horarios="http://iscte.pt/ontologias/horarios#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://iscte.pt/ontologias/horarios">
        <rdfs:comment xml:lang="pt">
            Ontologia que modela a estrutura de horários do ISCTE-IUL,
            permitindo detetar anomalias (sobrelotação, sobreposição de turnos/salas/professor,
            salas inadequadas, aulas sem sala) e suportar a otimização de horários.
            Versão 5.0 — alinhada com Neo4j Cypher v12:
              • NOVO: Classe Professor (subclasse de RecursoHumano) e suas propriedades
              • NOVO: ObjectProperty TurnoTemProfessor / ProfessorLecionaTurno
              • NOVO: ObjectProperty emConflitoProfessor (sobreposição temporal de professor)
              • NOVO: Subclasse AulaComSobreposicaoProfessor de Aula
              • NOVO: Classe ConflictGraph e propriedades slotOtimizado, salaOtimizada
              • NOVO: DatatypeProperties para suporte a algoritmos de otimização:
                slotOtimizado, salaOtimizada, objetivoSobrelotacao, objetivoAdequacao, objetivoFolgas
              • MANTIDO: CaracteristicaSala dividida em CaracteristicaReal e CaracteristicaPedida
              • MANTIDO: Propriedades temporais em Aula (SlotTemporal opcional)
              • MANTIDO: EM_CONFLITO_TURNO e EM_CONFLITO_SALA como object properties
              • MANTIDO: Labels de anomalia como subclasses de Aula
              • DEPRECATED: necessitaSala (derivável de caracPedida)
        </rdfs:comment>
        <rdfs:label xml:lang="pt">Ontologia de Gestão de Horários ISCTE-IUL</rdfs:label>
        <owl:versionInfo>5.0</owl:versionInfo>
    </owl:Ontology>


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <!-- http://www.w3.org/2001/XMLSchema#boolean -->
    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#boolean"/>

    <!-- http://www.w3.org/2001/XMLSchema#date -->
    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>

    <!-- http://www.w3.org/2001/XMLSchema#integer -->
    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>

    <!-- http://www.w3.org/2001/XMLSchema#positiveInteger -->
    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#positiveInteger"/>

    <!-- http://www.w3.org/2001/XMLSchema#string -->
    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#string"/>

    <!-- http://www.w3.org/2001/XMLSchema#time -->
    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#time"/>


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <!-- http://iscte.pt/ontologias/horarios#CarateristicaExigidaPor -->
    <!-- CORRECAO v4: rdfs:domain atualizado para CaracteristicaPedida -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#CarateristicaExigidaPor">
        <owl:inverseOf rdf:resource="http://iscte.pt/ontologias/horarios#exigeCarateristica"/>
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#CaracteristicaPedida"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:label xml:lang="pt">caracteristicaExigidaPor</rdfs:label>
        <rdfs:comment xml:lang="pt">Inverso de exigeCarateristica: aponta de uma CaracteristicaPedida para as Aulas que a exigem.</rdfs:comment>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#CaracteristicaPertenceASala -->
    <!-- CORRECAO v4: URI sem acento (era CaraterísticaPertenceA); domain atualizado para CaracteristicaReal -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#CaracteristicaPertenceASala">
        <owl:inverseOf rdf:resource="http://iscte.pt/ontologias/horarios#temCaracteristica"/>
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#CaracteristicaReal"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Sala"/>
        <rdfs:label xml:lang="pt">caracteristicaPertenceASala</rdfs:label>
        <rdfs:comment xml:lang="pt">Inverso de temCaracteristica: aponta de uma CaracteristicaReal para as Salas que a possuem.</rdfs:comment>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#CursoTemTurma -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#CursoTemTurma">
        <owl:inverseOf rdf:resource="http://iscte.pt/ontologias/horarios#TurmaPertenceACurso"/>
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Curso"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Turma"/>
        <rdfs:label xml:lang="pt">cursoTemTurma</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#CursoTemUnidadeExecucao -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#CursoTemUnidadeExecucao">
        <owl:inverseOf rdf:resource="http://iscte.pt/ontologias/horarios#pertenceACurso"/>
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Curso"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#UnidadeExecucao"/>
        <rdfs:label xml:lang="pt">cursoTemUnidadeExecucao</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#EdificioTemSala -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#EdificioTemSala">
        <owl:inverseOf rdf:resource="http://iscte.pt/ontologias/horarios#localizadaEm"/>
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Edificio"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Sala"/>
        <rdfs:label xml:lang="pt">edificioTemSala</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#Precede -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#Precede">
        <owl:inverseOf rdf:resource="http://iscte.pt/ontologias/horarios#PrecedidaPor"/>
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Precedência por número de aula dentro do mesmo turno: aula N precede aula N+1.</rdfs:comment>
        <rdfs:label xml:lang="pt">precede</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#PrecedeTipologicamente -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#PrecedeTipologicamente">
        <owl:inverseOf rdf:resource="http://iscte.pt/ontologias/horarios#PrecedidaTipologicamentePor"/>
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Precedência tipológica: a aula teórica N precede a aula prática N (mesmo número de sequência, tipo diferente, mesma UC).</rdfs:comment>
        <rdfs:label xml:lang="pt">precedeTipologicamente</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#PrecedidaPor -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#PrecedidaPor">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Inverso de Precede.</rdfs:comment>
        <rdfs:label xml:lang="pt">precedidaPor</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#PrecedidaTipologicamentePor -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#PrecedidaTipologicamentePor">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Inverso de PrecedeTipologicamente.</rdfs:comment>
        <rdfs:label xml:lang="pt">precedidaTipologicamentePor</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#SalaUsadaPor -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#SalaUsadaPor">
        <owl:inverseOf rdf:resource="http://iscte.pt/ontologias/horarios#utilizaSala"/>
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Sala"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:label xml:lang="pt">salaUsadaPor</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#SlotOcupadoPor -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#SlotOcupadoPor">
        <owl:inverseOf rdf:resource="http://iscte.pt/ontologias/horarios#temSlotTemporal"/>
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#SlotTemporal"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:label xml:lang="pt">slotOcupadoPor</rdfs:label>
        <rdfs:comment xml:lang="pt">Classe SlotTemporal disponível para uso futuro; no modelo atual as propriedades temporais residem diretamente em Aula.</rdfs:comment>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#TurmaPertenceACurso -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#TurmaPertenceACurso">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Turma"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Curso"/>
        <rdfs:label xml:lang="pt">turmaPertenceACurso</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#TurnoTemAula -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#TurnoTemAula">
        <owl:inverseOf rdf:resource="http://iscte.pt/ontologias/horarios#temTurno"/>
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Turno"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:label xml:lang="pt">turnoTemAula</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#UnidadeExecucaoTemTurno -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#UnidadeExecucaoTemTurno">
        <owl:inverseOf rdf:resource="http://iscte.pt/ontologias/horarios#pertenceAUnidadeExecucao"/>
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#UnidadeExecucao"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Turno"/>
        <rdfs:label xml:lang="pt">unidadeExecucaoTemTurno</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#emConflitoTurno -->
    <!-- NOVO v4: relação de conflito entre aulas no mesmo turno com sobreposição temporal -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#emConflitoTurno">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Liga duas aulas do mesmo turno que se sobrepõem temporalmente no mesmo dia.</rdfs:comment>
        <rdfs:label xml:lang="pt">emConflitoTurno</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#emConflitoSala -->
    <!-- NOVO v4: relação de conflito entre aulas na mesma sala com sobreposição temporal -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#emConflitoSala">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Liga duas aulas de turnos diferentes que utilizam a mesma sala com sobreposição temporal no mesmo dia.</rdfs:comment>
        <rdfs:label xml:lang="pt">emConflitoSala</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#exigeCarateristica -->
    <!-- CORRECAO v4: rdfs:range atualizado para CaracteristicaPedida -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#exigeCarateristica">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#CaracteristicaPedida"/>
        <rdfs:comment xml:lang="pt">Característica de sala exigida para esta aula (coluna "Características da sala pedida"). Aponta para CaracteristicaPedida (vocabulário Fénix).</rdfs:comment>
        <rdfs:label xml:lang="pt">aulaExigeCarateristica</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#localizadaEm -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#localizadaEm">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Sala"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Edificio"/>
        <rdfs:label xml:lang="pt">salaLocalizadaEm</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#pertenceACurso -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#pertenceACurso">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#UnidadeExecucao"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Curso"/>
        <rdfs:label xml:lang="pt">unidadeExecucaoPertenceACurso</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#pertenceAUnidadeExecucao -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#pertenceAUnidadeExecucao">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Turno"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#UnidadeExecucao"/>
        <rdfs:label xml:lang="pt">turnoPertenceAUnidadeExecucao</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#temCaracteristica -->
    <!-- CORRECAO v4: rdfs:range atualizado para CaracteristicaReal -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#temCaracteristica">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Sala"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#CaracteristicaReal"/>
        <rdfs:comment xml:lang="pt">Características permanentes da sala conforme o CSV de salas. Aponta para CaracteristicaReal (vocabulário das colunas do CSV).</rdfs:comment>
        <rdfs:label xml:lang="pt">salaTemCaracteristica</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#temSlotTemporal -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#temSlotTemporal">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#SlotTemporal"/>
        <rdfs:comment xml:lang="pt">Liga uma aula ao bloco de tempo em que ocorre. Disponível para uso futuro; no modelo atual as propriedades temporais residem diretamente em Aula.</rdfs:comment>
        <rdfs:label xml:lang="pt">aulaTemSlotTemporal</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#temTurma -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#temTurma">
        <owl:inverseOf rdf:resource="http://iscte.pt/ontologias/horarios#turmaTemTurno"/>
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Turno"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Turma"/>
        <rdfs:comment xml:lang="pt">Um turno pode ter associada uma ou mais turmas.</rdfs:comment>
        <rdfs:label xml:lang="pt">turnoTemTurma</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#temTurno -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#temTurno">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Turno"/>
        <rdfs:comment xml:lang="pt">Liga uma aula ao seu turno.</rdfs:comment>
        <rdfs:label xml:lang="pt">aulaTemTurno</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#turmaTemTurno -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#turmaTemTurno">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Turma"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Turno"/>
        <rdfs:label xml:lang="pt">turmaTemTurno</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://iscte.pt/ontologias/horarios#utilizaSala -->
    <owl:ObjectProperty rdf:about="http://iscte.pt/ontologias/horarios#utilizaSala">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://iscte.pt/ontologias/horarios#Sala"/>
        <rdfs:label xml:lang="pt">aulaUtilizaSala</rdfs:label>
    </owl:ObjectProperty>


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <!-- http://iscte.pt/ontologias/horarios#adequacao -->
    <!-- NOVO v4: classifica a correspondência entre a sala atribuída e a característica pedida -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#adequacao">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Classifica a adequação da sala face ao pedido: 'adequada', 'inadequada', 'sem_sala', 'sem_pedido'.</rdfs:comment>
        <rdfs:label xml:lang="pt">adequacao</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#anoCurricular -->
    <!-- NOVO v4: ano curricular no nó Aula e no nó Turno -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#anoCurricular">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://iscte.pt/ontologias/horarios#Aula"/>
                    <rdf:Description rdf:about="http://iscte.pt/ontologias/horarios#Turno"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="pt">Ano curricular (1, 2 ou 3) da aula ou turno, propagado do menor anoTurma das Turmas associadas.</rdfs:comment>
        <rdfs:label xml:lang="pt">anoCurricular</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#anoTurma -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#anoTurma">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Turma"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="pt">Ano curricular da turma, extraído da letra do código (A=1º ano, B=2º ano, C=3º ano). Ex: MEA1 → ano 1; ETB3 → ano 2.</rdfs:comment>
        <rdfs:label xml:lang="pt">anoTurma</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#anosCurriculares -->
    <!-- NOVO v4: lista de anos curriculares em que a UC é lecionada -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#anosCurriculares">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#UnidadeExecucao"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Lista (array Neo4j) dos anos curriculares distintos em que esta UC é lecionada, derivada das Turmas dos seus Turnos.</rdfs:comment>
        <rdfs:label xml:lang="pt">anosCurriculares</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#aulaId -->
    <!-- NOVO v4: identificador único da aula -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#aulaId">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Identificador único da aula, construído como codigoTurno_dataISO_horaInicio_sala.</rdfs:comment>
        <rdfs:label xml:lang="pt">aulaId</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#capacidadeExame -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#capacidadeExame">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Sala"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pt">capacidadeExame</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#capacidadeNormal -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#capacidadeNormal">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Sala"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="pt">Lotação normal da sala (coluna "Lotação" do CSV de horários).</rdfs:comment>
        <rdfs:label xml:lang="pt">capacidadeNormal</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#caracPedida -->
    <!-- NOVO v4: cópia do valor textual da característica pedida, para queries diretas -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#caracPedida">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Valor textual da coluna "Características da sala pedida para a aula". Redundante face à relação exigeCarateristica, mas útil para queries diretas.</rdfs:comment>
        <rdfs:label xml:lang="pt">caracPedida</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#codigoTurma -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#codigoTurma">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Turma"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Código identificador da turma (ex: MEA1).</rdfs:comment>
        <rdfs:label xml:lang="pt">codigoTurma</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#codigoTurno -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#codigoTurno">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Turno"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Código identificador do turno (ex: 01789TP01).</rdfs:comment>
        <rdfs:label xml:lang="pt">codigoTurno</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#dia -->
    <!-- CORRECAO v4: domínio alargado para incluir Aula (props temporais residem em Aula no modelo Neo4j) -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#dia">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://iscte.pt/ontologias/horarios#Aula"/>
                    <rdf:Description rdf:about="http://iscte.pt/ontologias/horarios#SlotTemporal"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Data concreta da aula em formato ISO (YYYY-MM-DD). No modelo Neo4j reside diretamente em Aula; SlotTemporal mantido para compatibilidade.</rdfs:comment>
        <rdfs:label xml:lang="pt">dia</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#diaDaSemana -->
    <!-- CORRECAO v4: domínio alargado para incluir Aula -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#diaDaSemana">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://iscte.pt/ontologias/horarios#Aula"/>
                    <rdf:Description rdf:about="http://iscte.pt/ontologias/horarios#SlotTemporal"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Dia da semana (ex: Seg, Ter, Qua, Qui, Sex, Sáb).</rdfs:comment>
        <rdfs:label xml:lang="pt">diaDaSemana</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#excedente -->
    <!-- NOVO v4: número de alunos acima da capacidade normal da sala -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#excedente">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="pt">Número de alunos inscritos no turno acima da capacidade normal da sala. Zero quando não há sobrelotação.</rdfs:comment>
        <rdfs:label xml:lang="pt">excedente</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#horaFim -->
    <!-- CORRECAO v4: domínio alargado para incluir Aula -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#horaFim">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://iscte.pt/ontologias/horarios#Aula"/>
                    <rdf:Description rdf:about="http://iscte.pt/ontologias/horarios#SlotTemporal"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Hora de fim da aula (ex: 14:30).</rdfs:comment>
        <rdfs:label xml:lang="pt">horaFim</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#horaFimMin -->
    <!-- NOVO v4: hora de fim em minutos desde meia-noite, para comparações numéricas -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#horaFimMin">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="pt">Hora de fim convertida para minutos desde meia-noite (ex: 14:30 → 870). Usada nas deteções de sobreposição temporal.</rdfs:comment>
        <rdfs:label xml:lang="pt">horaFimMin</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#horaInicio -->
    <!-- CORRECAO v4: domínio alargado para incluir Aula -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#horaInicio">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://iscte.pt/ontologias/horarios#Aula"/>
                    <rdf:Description rdf:about="http://iscte.pt/ontologias/horarios#SlotTemporal"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Hora de início da aula (ex: 13:00).</rdfs:comment>
        <rdfs:label xml:lang="pt">horaInicio</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#horaInicioMin -->
    <!-- NOVO v4: hora de início em minutos desde meia-noite, para comparações numéricas -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#horaInicioMin">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="pt">Hora de início convertida para minutos desde meia-noite (ex: 13:00 → 780). Usada nas deteções de sobreposição temporal.</rdfs:comment>
        <rdfs:label xml:lang="pt">horaInicioMin</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#inscritosNoTurno -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#inscritosNoTurno">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Turno"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="pt">Número de alunos inscritos neste turno.</rdfs:comment>
        <rdfs:label xml:lang="pt">inscritosNoTurno</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#necessitaSala -->
    <!-- CORRECAO v4: marcada como deprecated — derivável de caracPedida -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#necessitaSala">
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="pt">DEPRECATED: derivável de (caracPedida = "Não necessita de sala"). Não é populada no modelo Neo4j v6.</rdfs:comment>
        <rdfs:label xml:lang="pt">necessitaSala</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#nomeCaracteristica -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#nomeCaracteristica">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#CaracteristicaSala"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Nome da característica tal como aparece no CSV (ex: "Sala Aulas Mestrado", "Laboratório de Informática").</rdfs:comment>
        <rdfs:label xml:lang="pt">nomeCaracteristica</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#nomeCurso -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#nomeCurso">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Curso"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Nome completo do curso (ex: LEI - Licenciatura em Engenharia Informática).</rdfs:comment>
        <rdfs:label xml:lang="pt">nomeCurso</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#nomeEdificio -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#nomeEdificio">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Edificio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">nomeEdificio</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#nomeSala -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#nomeSala">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Sala"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">nomeSala</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#nomeUnidade -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#nomeUnidade">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#UnidadeExecucao"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pt">nomeUnidadeExecucao</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#numTurma -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#numTurma">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Turma"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="pt">Número da turma, presente no final do código de turma.</rdfs:comment>
        <rdfs:label xml:lang="pt">numTurma</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#numeroSequencia -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#numeroSequencia">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="pt">Número de ordem da aula dentro do turno (1ª aula, 2ª aula...). Determina a relação Precede.</rdfs:comment>
        <rdfs:label xml:lang="pt">numeroSequencia</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#regimeTurma -->
    <!-- NOVO v4: declarado para Turma (existia no Cypher mas não na ontologia) -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#regimeTurma">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Turma"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Regime horário da turma: 'Diurno' ou 'Pos-Laboral'.</rdfs:comment>
        <rdfs:label xml:lang="pt">regimeTurma</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#semestre -->
    <!-- NOVO v4: semestre em Aula, Turno e UnidadeExecucao (era semestreEvento em SlotTemporal) -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#semestre">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://iscte.pt/ontologias/horarios#Aula"/>
                    <rdf:Description rdf:about="http://iscte.pt/ontologias/horarios#Turno"/>
                    <rdf:Description rdf:about="http://iscte.pt/ontologias/horarios#UnidadeExecucao"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Semestre em que o evento ocorre: '1S', '2S' ou '1S|2S' (para UCs de ambos os semestres).</rdfs:comment>
        <rdfs:label xml:lang="pt">semestre</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#semestreEvento -->
    <!-- Mantida para compatibilidade com SlotTemporal; ver também 'semestre' -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#semestreEvento">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#SlotTemporal"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Semestre em que o slot temporal ocorre. Para uso com SlotTemporal; ver a propriedade 'semestre' para Aula/Turno/UnidadeExecucao.</rdfs:comment>
        <rdfs:label xml:lang="pt">semestreEvento</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#sigla -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#sigla">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Curso"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Abreviatura do curso (ex: ME, LP, LETI).</rdfs:comment>
        <rdfs:label xml:lang="pt">siglaCurso</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#tipoAula -->
    <!-- NOVO v4: tipo de aula como string em Aula (complementa as subclasses Teorica, TeoricoPratica, etc.) -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#tipoAula">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Tipo de aula como string: 'Teórica', 'Teórico-Prática', 'Prático-Laboratorial', 'Seminário', 'Orientação Tutorial', 'Outro'. Complementa os labels de subclasse.</rdfs:comment>
        <rdfs:label xml:lang="pt">tipoAula</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#tipoFormacao -->
    <!-- CORRECAO v4: domínio alargado para incluir Turma -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#tipoFormacao">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://iscte.pt/ontologias/horarios#Curso"/>
                    <rdf:Description rdf:about="http://iscte.pt/ontologias/horarios#Turma"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Tipo de formação: 'Mestrado', 'Licenciatura', 'Doutoramento', 'Pós-Graduação', 'Programa/Centro Específico', 'Outra Formação', 'Desconhecido'.</rdfs:comment>
        <rdfs:label xml:lang="pt">tipoFormacao</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://iscte.pt/ontologias/horarios#tipoTurno -->
    <owl:DatatypeProperty rdf:about="http://iscte.pt/ontologias/horarios#tipoTurno">
        <rdfs:domain rdf:resource="http://iscte.pt/ontologias/horarios#Turno"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Tipo de turno extraído do código: T (Teórico), TP (Teórico-Prático), PL (Prático-Laboratorial), S (Seminário), OT (Orientação Tutorial).</rdfs:comment>
        <rdfs:label xml:lang="pt">tipoTurno</rdfs:label>
    </owl:DatatypeProperty>


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <!-- http://iscte.pt/ontologias/horarios#Aula -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Aula">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Evento"/>
        <rdfs:comment xml:lang="pt">Sessão letiva agendada: pode ser Teórica, TP, PL, Seminário ou OT.</rdfs:comment>
        <rdfs:label xml:lang="pt">Aula</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#Avaliacao -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Avaliacao">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Evento"/>
        <rdfs:label xml:lang="pt">Avaliacao</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#CaracteristicaSala -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#CaracteristicaSala">
        <rdfs:comment xml:lang="pt">Classe abstrata para características de sala. Subclasses: CaracteristicaReal (do CSV de salas) e CaracteristicaPedida (vocabulário Fénix).</rdfs:comment>
        <rdfs:label xml:lang="pt">CaracteristicaDeSala</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#CaracteristicaReal -->
    <!-- NOVO v4: vocabulário das colunas do CSV de salas (presença = 'X') -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#CaracteristicaReal">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#CaracteristicaSala"/>
        <rdfs:comment xml:lang="pt">Característica física real de uma sala, conforme as colunas do CSV de salas (presença marcada com 'X'). Ex: "Laboratório de Informática", "Anfiteatro aulas".</rdfs:comment>
        <rdfs:label xml:lang="pt">CaracteristicaReal</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#CaracteristicaPedida -->
    <!-- NOVO v4: vocabulário Fénix (coluna "Características da sala pedida para a aula") -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#CaracteristicaPedida">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#CaracteristicaSala"/>
        <rdfs:comment xml:lang="pt">Característica de sala pedida pelo docente (vocabulário Fénix), coluna "Características da sala pedida para a aula". Ex: "Sala/anfiteatro aulas", "Não necessita de sala".</rdfs:comment>
        <rdfs:label xml:lang="pt">CaracteristicaPedida</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#Conferencia -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Conferencia">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#NaoLetivo"/>
        <rdfs:label xml:lang="pt">Conferencia</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#Curso -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Curso">
        <rdfs:comment xml:lang="pt">Curso académico (ex: ME, LP, LETI). Pode agrupar vários cursos em simultâneo quando a UC é partilhada.</rdfs:comment>
        <rdfs:label xml:lang="pt">Curso</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#DefesaTese -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#DefesaTese">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Avaliacao"/>
        <rdfs:label xml:lang="pt">DefesaTese</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#Edificio -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Edificio">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#EspacoFisico"/>
        <rdfs:comment xml:lang="pt">Edifício onde a sala se localiza (prefixo do código: AA = Ala Autónoma, C = Edifício C, etc.).</rdfs:comment>
        <rdfs:label xml:lang="pt">Edificio</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#EspacoFisico -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#EspacoFisico">
        <rdfs:comment xml:lang="pt">Classe abstrata de espaços físicos do ISCTE.</rdfs:comment>
        <rdfs:label xml:lang="pt">EspacoFisico</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#Evento -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Evento">
        <rdfs:comment xml:lang="pt">Classe abstrata raiz de todos os eventos agendáveis no ISCTE.</rdfs:comment>
        <rdfs:label xml:lang="pt">Evento</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#Exame -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Exame">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Avaliacao"/>
        <rdfs:label xml:lang="pt">Exame</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#NaoLetivo -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#NaoLetivo">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Evento"/>
        <rdfs:label xml:lang="pt">NaoLetivo</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#OrientacaoTutorial -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#OrientacaoTutorial">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:label xml:lang="pt">OrientacaoTutorial</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#PraticaLaboratorial -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#PraticaLaboratorial">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Aula prático-laboratorial (PL). Código de turno contém "PL".</rdfs:comment>
        <rdfs:label xml:lang="pt">PraticaLaboratorial</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#ReuniaoDocentes -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#ReuniaoDocentes">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#NaoLetivo"/>
        <rdfs:label xml:lang="pt">ReuniaoDocentes</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#Sala -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Sala">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#EspacoFisico"/>
        <rdfs:comment xml:lang="pt">Espaço físico onde as aulas se realizam (ex: AA2.25).</rdfs:comment>
        <rdfs:label xml:lang="pt">Sala</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#Seminario -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Seminario">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:label xml:lang="pt">Seminario</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#SlotTemporal -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#SlotTemporal">
        <rdfs:comment xml:lang="pt">Bloco de tempo em que uma aula pode decorrer. No modelo Neo4j atual as propriedades temporais residem diretamente em Aula. SlotTemporal mantido para uso futuro ou para modelos mais normalizados.</rdfs:comment>
        <rdfs:label xml:lang="pt">SlotTemporal</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#Teorica -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Teorica">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Aula teórica (T). Código de turno contém "T" mas não "TP".</rdfs:comment>
        <rdfs:label xml:lang="pt">Teorica</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#TeoricoPratica -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#TeoricoPratica">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Aula teórico-prática (TP). Código de turno contém "TP".</rdfs:comment>
        <rdfs:label xml:lang="pt">TeoricoPratica</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#Teste -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Teste">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Avaliacao"/>
        <rdfs:label xml:lang="pt">Teste</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#Turma -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Turma">
        <rdfs:comment xml:lang="pt">Turma associada a um turno (ex: MEA1). Um turno pode ter várias turmas.</rdfs:comment>
        <rdfs:label xml:lang="pt">Turma</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#Turno -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Turno">
        <rdfs:comment xml:lang="pt">Turno de uma unidade de execução (ex: 01789TP01). Identifica o grupo horário de alunos.</rdfs:comment>
        <rdfs:label xml:lang="pt">Turno</rdfs:label>
    </owl:Class>


    <!-- http://iscte.pt/ontologias/horarios#UnidadeExecucao -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#UnidadeExecucao">
        <rdfs:comment xml:lang="pt">Unidade curricular ou disciplina dentro de um curso (ex: Teoria dos Jogos e dos Contratos).</rdfs:comment>
        <rdfs:label xml:lang="pt">UnidadeDeExecucao</rdfs:label>
    </owl:Class>


    <!-- Labels de anomalia como subclasses de Aula -->
    <!-- NOVO v4: declaração formal dos labels de anomalia usados no Cypher -->

    <!-- http://iscte.pt/ontologias/horarios#AulaSemSalaAtribuida -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#AulaSemSalaAtribuida">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Aula que necessita de sala mas não tem nenhuma atribuída (ausência da relação utilizaSala e caracPedida diferente de "Não necessita de sala").</rdfs:comment>
        <rdfs:label xml:lang="pt">Aula_Sem_Sala_Atribuida</rdfs:label>
    </owl:Class>

    <!-- http://iscte.pt/ontologias/horarios#AulaSobrelotada -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#AulaSobrelotada">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Aula em que o número de inscritos no turno excede a capacidade normal da sala (excedente &gt; 0).</rdfs:comment>
        <rdfs:label xml:lang="pt">Aula_Sobrelotada</rdfs:label>
    </owl:Class>

    <!-- http://iscte.pt/ontologias/horarios#AulaComSalaInadequada -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#AulaComSalaInadequada">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Aula em que a sala atribuída não possui a característica pedida (adequacao = "inadequada").</rdfs:comment>
        <rdfs:label xml:lang="pt">Aula_Com_Sala_Inadequada</rdfs:label>
    </owl:Class>

    <!-- http://iscte.pt/ontologias/horarios#AulaComSobreposicaoTurno -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#AulaComSobreposicaoTurno">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Aula que se sobrepõe temporalmente com outra aula do mesmo turno no mesmo dia.</rdfs:comment>
        <rdfs:label xml:lang="pt">Aula_Com_Sobreposicao_Turno</rdfs:label>
    </owl:Class>

    <!-- http://iscte.pt/ontologias/horarios#AulaComSobreposicaoSala -->
    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#AulaComSobreposicaoSala">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Aula que se sobrepõe temporalmente com outra aula de turno diferente na mesma sala no mesmo dia.</rdfs:comment>
        <rdfs:label xml:lang="pt">Aula_Com_Sobreposicao_Sala</rdfs:label>
    </owl:Class>


