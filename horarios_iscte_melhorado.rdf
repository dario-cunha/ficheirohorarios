    <!-- http://iscte.pt/ontologias/horarios#Aula -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Aula">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Evento"/>
        <rdfs:comment xml:lang="pt">Sessão letiva agendada: pode ser Teórica, TP, PL, Seminário ou OT.</rdfs:comment>
        <rdfs:label xml:lang="pt">Aula</rdfs:label>
    </owl:Class>
    


    <!-- http://iscte.pt/ontologias/horarios#Avaliacao -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Avaliacao">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Evento"/>
        <rdfs:label xml:lang="pt">Avaliacao</rdfs:label>
    </owl:Class>
    


    <!-- http://iscte.pt/ontologias/horarios#CaracteristicaSala -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#CaracteristicaSala">
        <rdfs:comment xml:lang="pt">Tipo de equipamento ou classificação de uma sala (ex: Sala de Aulas Normal, Laboratório de Informática, Anfiteatro aulas).</rdfs:comment>
        <rdfs:label xml:lang="pt">CaracteristicaDeSala</rdfs:label>
    </owl:Class>
    


    <!-- http://iscte.pt/ontologias/horarios#Conferencia -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Conferencia">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#NaoLetivo"/>
        <rdfs:label xml:lang="pt">Conferencia</rdfs:label>
    </owl:Class>
    


    <!-- http://iscte.pt/ontologias/horarios#Curso -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Curso">
        <rdfs:comment xml:lang="pt">Curso académico (ex: ME, LP, LETI). Pode agrupar vários cursos em simultâneo quando a UC é partilhada.</rdfs:comment>
        <rdfs:label xml:lang="pt">Curso</rdfs:label>
    </owl:Class>
    


    <!-- http://iscte.pt/ontologias/horarios#DefesaTese -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#DefesaTese">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Avaliacao"/>
        <rdfs:label xml:lang="pt">DefesaTese</rdfs:label>
    </owl:Class>
    


    <!-- http://iscte.pt/ontologias/horarios#Edificio -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Edificio">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#EspacoFisico"/>
        <rdfs:comment xml:lang="pt">Edifício onde a sala se localiza (prefixo do código: AA = Ala Autónoma, C = Edifício C, etc.).</rdfs:comment>
        <rdfs:label xml:lang="pt">Edificio</rdfs:label>
    </owl:Class>
    


    <!-- http://iscte.pt/ontologias/horarios#EspacoFisico -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#EspacoFisico">
        <rdfs:comment xml:lang="pt">Classe abstrata de espaços físicos do ISCTE.</rdfs:comment>
        <rdfs:label xml:lang="pt">EspacoFisico</rdfs:label>
    </owl:Class>
    


    <!-- http://iscte.pt/ontologias/horarios#Evento -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Evento">
        <rdfs:comment xml:lang="pt">Classe abstrata raiz de todos os eventos agendáveis no ISCTE.</rdfs:comment>
        <rdfs:label xml:lang="pt">Evento</rdfs:label>
    </owl:Class>
    


    <!-- http://iscte.pt/ontologias/horarios#Exame -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Exame">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Avaliacao"/>
        <rdfs:label xml:lang="pt">Exame</rdfs:label>
    </owl:Class>
    


    <!-- http://iscte.pt/ontologias/horarios#NaoLetivo -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#NaoLetivo">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Evento"/>
        <rdfs:label xml:lang="pt">NaoLetivo</rdfs:label>
    </owl:Class>
    


    <!-- http://iscte.pt/ontologias/horarios#OrientacaoTutorial -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#OrientacaoTutorial">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:label xml:lang="pt">OrientacaoTutorial</rdfs:label>
    </owl:Class>
    


    <!-- http://iscte.pt/ontologias/horarios#PraticaLaboratorial -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#PraticaLaboratorial">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Aula prático-laboratorial (PL). Código de turno contém &quot;PL&quot;.</rdfs:comment>
        <rdfs:label xml:lang="pt">PraticaLaboratorial</rdfs:label>
    </owl:Class>
    


    <!-- http://iscte.pt/ontologias/horarios#ReuniaoDocentes -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#ReuniaoDocentes">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#NaoLetivo"/>
        <rdfs:label xml:lang="pt">ReuniaoDocentes</rdfs:label>
    </owl:Class>
    


    <!-- http://iscte.pt/ontologias/horarios#Sala -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Sala">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#EspacoFisico"/>
        <rdfs:comment xml:lang="pt">Espaço físico onde as aulas se realizam (ex: AA2.25).</rdfs:comment>
        <rdfs:label xml:lang="pt">Sala</rdfs:label>
    </owl:Class>
    


    <!-- http://iscte.pt/ontologias/horarios#Seminario -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Seminario">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:label xml:lang="pt">Seminario</rdfs:label>
    </owl:Class>
    


    <!-- http://iscte.pt/ontologias/horarios#SlotTemporal -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#SlotTemporal">
        <rdfs:comment xml:lang="pt">Bloco de tempo em que uma aula decorre: dia concreto, dia da semana, hora de início e hora de fim.</rdfs:comment>
        <rdfs:label xml:lang="pt">SlotTemporal</rdfs:label>
    </owl:Class>
    


    <!-- http://iscte.pt/ontologias/horarios#Teorica -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Teorica">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Aula teórica (T). Código de turno contém &quot;T&quot; mas não &quot;TP&quot;.</rdfs:comment>
        <rdfs:label xml:lang="pt">Teorica</rdfs:label>
    </owl:Class>
    


    <!-- http://iscte.pt/ontologias/horarios#TeoricoPratica -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#TeoricoPratica">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Aula"/>
        <rdfs:comment xml:lang="pt">Aula teórico-prática (TP). Código de turno contém &quot;TP&quot;.</rdfs:comment>
        <rdfs:label xml:lang="pt">TeoricoPratica</rdfs:label>
    </owl:Class>
    


    <!-- http://iscte.pt/ontologias/horarios#Teste -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Teste">
        <rdfs:subClassOf rdf:resource="http://iscte.pt/ontologias/horarios#Avaliacao"/>
        <rdfs:label xml:lang="pt">Teste</rdfs:label>
    </owl:Class>
    


    <!-- http://iscte.pt/ontologias/horarios#Turma -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Turma">
        <rdfs:comment xml:lang="pt">Turma associada a um turno (ex: MEA1). Um turno pode ter várias turmas.</rdfs:comment>
        <rdfs:label xml:lang="pt">Turma</rdfs:label>
    </owl:Class>
    


    <!-- http://iscte.pt/ontologias/horarios#Turno -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#Turno">
        <rdfs:comment xml:lang="pt">Turno de uma unidade de execução (ex: 01789TP01). Identifica o grupo horário de alunos.</rdfs:comment>
        <rdfs:label xml:lang="pt">Turno</rdfs:label>
    </owl:Class>
    


    <!-- http://iscte.pt/ontologias/horarios#UnidadeExecucao -->

    <owl:Class rdf:about="http://iscte.pt/ontologias/horarios#UnidadeExecucao">
        <rdfs:comment xml:lang="pt">Unidade curricular ou disciplina dentro de um curso (ex: Teoria dos Jogos e dos Contratos).</rdfs:comment>
        <rdfs:label xml:lang="pt">UnidadeDeExecucao</rdfs:label>
    </owl:Class>
    


